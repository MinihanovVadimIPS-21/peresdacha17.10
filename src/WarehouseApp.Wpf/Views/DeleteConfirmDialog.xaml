<Window x:Class="WarehouseApp.Wpf.Views.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления" Height="210" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="TargetNameText" Grid.Row="1" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBox x:Name="ConfirmTextBox" Grid.Row="2" Style="{StaticResource ValidatingTextBoxStyle}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Удалить" Width="100" Margin="0,0,8,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
