<Window x:Class="WarehouseApp.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организации" Height="480" Width="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Label DockPanel.Dock="Top" Content="Организации" Padding="2,0,0,2"/>
                <ListView ItemsSource="{Binding Organizations}"
                          SelectedItem="{Binding SelectedOrganization, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PreviewMouseRightButtonDown="ListView_PreviewMouseRightButtonDown">
                    <ListView.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}"/>
                    </ListView.InputBindings>

                    <ListView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Открыть (Склады и Товары)" Command="{Binding OpenCommand}" FontWeight="Bold"/>
                            <Separator/>
                            <MenuItem Header="Новая организация" Command="{Binding AddCommand}"/>
                            <MenuItem Header="Изменить организацию" Command="{Binding EditCommand}"/>
                            <MenuItem Header="Удалить организацию" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </DockPanel>

            <StackPanel Grid.Column="1">
                <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCommand}"/>
                <Button Content="Закрыть" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,8,0,0"
                   Style="{StaticResource StatusBarTextStyle}"
                   Text="{Binding SelectedOrganization.Name, TargetNullValue='Организация не выбрана'}"/>
    </Grid>
</Window>