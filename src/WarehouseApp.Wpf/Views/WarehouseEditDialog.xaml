<Window x:Class="WarehouseApp.Wpf.Views.WarehouseEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад" Height="230" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Наименование склада:"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1"/>

        <Label Grid.Row="2" Content="Адрес (необязательно):" Margin="0,8,0,0"/>
        <TextBox x:Name="AddressTextBox" Grid.Row="3"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
