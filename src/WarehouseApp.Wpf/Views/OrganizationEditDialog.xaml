<Window x:Class="WarehouseApp.Wpf.Views.OrganizationEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организация" Height="170" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Наименование компании:"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
