<Window x:Class="WarehouseApp.Wpf.Views.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Наименование *"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1"/>

        <Label Grid.Row="2" Content="Категория" Margin="0,6,0,0"/>
        <TextBox x:Name="CategoryTextBox" Grid.Row="3"/>

        <Label Grid.Row="4" Content="Производитель" Margin="0,6,0,0"/>
        <TextBox x:Name="ManufacturerTextBox" Grid.Row="5"/>

        <Label Grid.Row="6" Content="Поставщик" Margin="0,6,0,0"/>
        <TextBox x:Name="SupplierTextBox" Grid.Row="7"/>

        <Grid Grid.Row="8" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Цена *"/>
                <TextBox x:Name="PriceTextBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Остаток *"/>
                <TextBox x:Name="StockTextBox"/>
            </StackPanel>
        </Grid>

        <Label Grid.Row="9" Content="Скидка, %" Margin="0,6,0,0"/>
        <TextBox x:Name="DiscountTextBox" Grid.Row="10"/>

        <Label Grid.Row="11" Content="Путь к фото (необязательно)" Margin="0,6,0,0"/>
        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PhotoPathTextBox" Grid.Column="0"/>
            <Button Grid.Column="1" Content="Обзор..." Margin="8,0,0,0" Click="BrowsePhoto_Click"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="13" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="100" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
